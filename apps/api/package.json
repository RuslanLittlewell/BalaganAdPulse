{
  "name": "@adpulse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": {
      "compiled": "./dist/shared/*",
      "default": "./src/shared/*"
    }
  },
  "scripts": {
    "dev": "tsx watch src/composition/server.ts",
    "build": "tsc",
    "start": "node --conditions=compiled dist/composition/server.js",
    "db:test:deploy": "DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/adpulse_test?schema=public\" prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "seed": "tsx src/composition/seed-cli.ts"
  },
  "dependencies": {
    "@adpulse/access-policy": "^0.1.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@prisma/client": "^6.19.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.8",
    "multer": "^2.3.0",
    "prisma": "^6.19.3",
    "swagger-ui-dist": "^5.32.15",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
