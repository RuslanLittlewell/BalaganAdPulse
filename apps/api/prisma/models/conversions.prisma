model MetaDataset {
  projectId      String    @id @map("project_id")
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orgId          String    @map("org_id")
  datasetId      String    @map("dataset_id") @db.VarChar(32)
  datasetName    String    @map("dataset_name")
  encryptedToken String    @map("encrypted_token")
  testEventCode  String?   @map("test_event_code") @db.VarChar(64)
  currency       String    @db.VarChar(3)
  state          String    @default("ACTIVE") @db.VarChar(16)
  lastError      String?   @map("last_error")
  lastSentAt     DateTime? @map("last_sent_at")
  revision       String
  leaseOwner     String?   @map("lease_owner")
  leaseUntil     DateTime? @map("lease_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("meta_dataset")
}

model MetaConversionSend {
  id            String              @id @default(uuid())
  orgId         String              @map("org_id")
  projectId     String              @map("project_id")
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leadId        String              @map("lead_id")
  lead          Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  eventId       String?             @map("event_id")
  event         CrmConversionEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventName     String              @map("event_name") @db.VarChar(50)
  reachedAt     DateTime            @map("reached_at")
  status        String              @db.VarChar(16)
  holdUntil     DateTime?           @map("hold_until")
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @map("next_attempt_at")
  lastError     String?             @map("last_error")
  value         Decimal?            @db.Decimal(18, 4)
  currency      String?             @db.VarChar(3)
  test          Boolean             @default(false)
  sentAt        DateTime?           @map("sent_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@unique([leadId, eventId])
  @@index([projectId, status, nextAttemptAt])
  @@index([projectId, reachedAt(sort: Desc)])
  @@index([status, reachedAt])
  @@map("meta_conversion_send")
}
