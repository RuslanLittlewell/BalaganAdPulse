POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=adpulse
# Passed to the api container. Both placeholders below MUST be replaced before
# deploying: they are published in this repository, and a token signed with
# this secret is accepted for any user. Startup refuses them when
# NODE_ENV=production.
JWT_SECRET=dev-secret-change-me
INVITE_CODE=adpulse-invite
