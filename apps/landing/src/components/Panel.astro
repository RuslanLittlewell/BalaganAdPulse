---
interface Props {
  class?: string;
  cardClass?: string;
  flush?: boolean;
  [attribute: string]: unknown;
}

const { class: className, cardClass, flush = false, ...rest } = Astro.props;
---

<div class:list={["panel", className]} {...rest}>
  <div class:list={["panel-card", flush ? "panel-card-flush" : "panel-card-padded", cardClass]}>
    <slot />
  </div>
</div>

<style>
  .panel {
    display: flex;
    flex-direction: column;
  }

  .panel-card {
    display: flex;
    flex: 1;
    flex-direction: column;
    border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    border-radius: 1rem;
    background: linear-gradient(180deg, var(--card), color-mix(in srgb, var(--card) 70%, var(--background)));
    transition:
      border-color 0.3s,
      box-shadow 0.35s;
  }

  .panel-card-padded {
    padding: clamp(0.875rem, 2.2vw, 1.75rem);
  }

  .panel-card-flush {
    overflow: hidden;
  }

  @media (hover: hover) and (pointer: fine) {
    .panel:hover > .panel-card {
      border-color: color-mix(in srgb, var(--foreground) 24%, transparent);
      box-shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 8px 24px -12px rgb(0 0 0 / 0.25);
    }
  }
</style>
