model User {
  id              String         @id @default(uuid())
  email           String?        @unique
  login           String?        @unique
  name            String
  passwordHash    String         @map("password_hash")
  issuedPassword  String?        @map("issued_password")
  image           String?
  avatarPath      String?        @map("avatar_path")
  phone           String?
  telegram        String?
  isPlatformAdmin Boolean        @default(false) @map("is_platform_admin")
  createdAt       DateTime       @default(now()) @map("created_at")
  refreshTokens   RefreshToken[]
  passwordReset   PasswordReset?
  memberships     Membership[]
  invitesUsed     Invite[]
  twoFactor       TwoFactor?
  backupCodes     TwoFactorBackupCode[]
  trustedAddresses TrustedAddress[]
  twoFactorChallenges TwoFactorChallenge[]

  @@map("app_user")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_token")
}

model SignInLock {
  key           String    @id
  failures      Int       @default(0)
  round         Int       @default(0)
  lockedUntil   DateTime? @map("locked_until")
  resetRequired Boolean   @default(false) @map("reset_required")
  updatedAt     DateTime  @default(now()) @map("updated_at")

  @@index([updatedAt])
  @@map("sign_in_lock")
}
