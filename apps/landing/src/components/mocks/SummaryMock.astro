---
import MockWindow from "./MockWindow.astro";

const tiles = [
  { label: "Расход", value: "12 480 $", points: "0,22 12,18 24,20 36,12 48,14 60,6 72,9 84,4" },
  { label: "Лиды", value: "1 204", points: "0,20 12,21 24,15 36,16 48,10 60,12 72,6 84,3" },
  { label: "Цена лида", value: "10,4 $", points: "0,6 12,9 24,8 36,13 48,12 60,16 72,15 84,19" },
  { label: "Выручка", value: "38 900 $", points: "0,24 12,20 24,21 36,14 48,11 60,13 72,7 84,5" },
];
const online = ["#e8703a", "#4a8fe7", "#46b58a", "#b968d9", "#d9a441"];
---

<MockWindow caption="Сентябрь · все проекты агентства" label="Дашборд">
  <div class="grid grid-cols-2 gap-2.5 @2xl:grid-cols-4">
    {tiles.map((tile, index) => (
      <div class="mock-rise rounded-2xl border border-border p-3" style={`--d: ${index * 0.1}s`}>
        <p class="text-[11px] text-muted-foreground">{tile.label}</p>
        <p class="mt-1 text-lg font-semibold tabular-nums">{tile.value}</p>
        <svg viewBox="0 0 84 26" aria-hidden="true" class="mt-2 h-7 w-full text-primary" preserveAspectRatio="none">
          <polyline class="mock-draw" points={tile.points} pathLength="1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style={`--d: ${0.3 + index * 0.1}s`} />
        </svg>
      </div>
    ))}
  </div>
  <div class="mt-3 grid gap-2.5 @2xl:grid-cols-2">
    <div class="mock-rise rounded-2xl border border-border p-3" style="--d: 0.5s">
      <p class="text-[11px] font-semibold">Кто сейчас в сети</p>
      <div class="mt-2 flex items-center">
        {online.map((color, index) => (
          <span class="mock-pop -ml-1.5 grid size-8 place-items-center rounded-full border-2 border-card text-[10px] font-bold text-white first:ml-0" style={`background: ${color}; --d: ${0.7 + index * 0.08}s`}>
            <span class="mock-blur">АБ</span>
          </span>
        ))}
        <span class="ml-3 text-[11px] text-muted-foreground">5 в сети</span>
      </div>
    </div>
    <div class="mock-rise rounded-2xl border border-border p-3" style="--d: 0.6s">
      <p class="text-[11px] font-semibold">Важная информация</p>
      <p class="mt-2 flex items-center gap-2 text-xs">
        <span class="size-2 shrink-0 rounded-full" style="background: var(--kpi-behind)"></span>
        Проектов без KPI: 2
      </p>
      <p class="mt-1 text-[11px] text-muted-foreground"><span class="mock-blur">Мебельная фабрика, Кофейня</span></p>
    </div>
  </div>
  <Fragment slot="footer">
    <span class="mock-chip">Meta + Google Ads</span>
    <span class="mock-chip">по каналам и проектам</span>
  </Fragment>
</MockWindow>
