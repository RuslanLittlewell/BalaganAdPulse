enum NotificationKind {
  KPI_MET
  PROJECT_CREATED
  TASK_ASSIGNED

  @@map("notification_kind")
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String           @map("recipient_id")
  kind        NotificationKind
  projectId   String?          @map("project_id")
  taskId      String?          @map("task_id")
  actorId     String?          @map("actor_id")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient Membership  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     Membership? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
  @@map("notification")
}
