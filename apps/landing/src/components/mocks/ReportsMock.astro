---
import Download from "@lucide/astro/icons/download";
import MockWindow from "./MockWindow.astro";

const weeks = [42, 58, 51, 74, 66, 88];
const totals = [
  { label: "Расход", value: "4 120 $" },
  { label: "Лиды", value: "386" },
  { label: "Цена лида", value: "10,7 $" },
];
---

<MockWindow caption="Отчёт за сентябрь · Летний запуск" label="Отчёты">
  <div class="mx-auto max-w-md rounded-2xl border border-border bg-background/60 p-4 shadow-inner">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-sm font-bold">Отчёт за сентябрь</p>
        <p class="mock-blur text-[11px] text-muted-foreground">Летний запуск · Balagan</p>
      </div>
      <span class="mock-pop inline-flex items-center gap-1.5 rounded-full bg-foreground px-3 py-1.5 text-[11px] font-semibold text-background" style="--d: 1.2s">
        <Download class="size-3" aria-hidden="true" />
        PDF
      </span>
    </div>
    <div class="mt-3 grid grid-cols-3 gap-2">
      {totals.map((total, index) => (
        <div class="mock-rise rounded-xl border border-border p-2" style={`--d: ${index * 0.1}s`}>
          <p class="text-[10px] text-muted-foreground">{total.label}</p>
          <p class="text-sm font-semibold tabular-nums">{total.value}</p>
        </div>
      ))}
    </div>
    <div class="mt-3 flex h-20 items-end gap-2 rounded-xl border border-border p-2">
      {weeks.map((height, index) => (
        <span class="mock-grow-y flex-1 rounded-md bg-primary/80" style={`height: ${height}%; --d: ${0.3 + index * 0.08}s`}></span>
      ))}
    </div>
    <p class="mt-3 text-[10px] font-semibold text-muted-foreground">Лучшие объявления</p>
    <div class="mt-1.5 grid grid-cols-3 gap-2">
      {[0, 1, 2].map((index) => (
        <span class="mock-rise aspect-square rounded-lg bg-gradient-to-br from-primary/40 to-muted" style={`--d: ${0.8 + index * 0.1}s`}></span>
      ))}
    </div>
  </div>
</MockWindow>
