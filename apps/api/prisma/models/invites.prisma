enum RegistrationType {
  CLIENT
  EMPLOYEE
  CLIENT_STAFF

  @@map("registration_type")
}

model Invite {
  id               String           @id @default(uuid())
  orgId            String           @map("org_id")
  code             String           @unique
  registrationType RegistrationType @default(EMPLOYEE) @map("registration_type")
  role             Role?
  clientId         String?          @map("client_id")
  email            String?
  expiresAt        DateTime?        @map("expires_at")
  revokedAt        DateTime?        @map("revoked_at")
  usedAt           DateTime?        @map("used_at")
  usedById         String?          @map("used_by_id")
  createdById      String?          @map("created_by_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  org              Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  usedBy           User?            @relation(fields: [usedById], references: [id], onDelete: SetNull)
  createdBy        Membership?      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  client           Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projects         InviteProject[]

  @@index([orgId, createdAt(sort: Desc)])
  @@index([clientId])
  @@map("invite")
}

model InviteProject {
  inviteId  String   @map("invite_id")
  projectId String   @map("project_id")
  invite    Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([inviteId, projectId])
  @@index([projectId])
  @@map("invite_project")
}
