generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// What a member may do. Held by a membership rather than by an account, so the
/// same person can be staff in one organization and a customer in another.
enum Role {
  ADMIN
  MANAGER
  GUEST
  CLIENT

  @@map("role")
}

/// Suspension lives here rather than on the account: it withdraws a person's
/// access to one organization without touching their ability to sign in.
enum MembershipStatus {
  ACTIVE
  SUSPENDED

  @@map("membership_status")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE

  @@map("audit_action")
}

/// The agency itself, and the boundary every other record sits inside.
model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  members     Membership[]
  clients     Client[]
  invites     Invite[]
  auditEvents AuditEvent[]

  @@map("organization")
}

/// One user's place in one organization. The role is read per request rather
/// than carried in the access token, so a suspension or a demotion takes effect
/// on the very next call instead of when the token expires.
model Membership {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  orgId       String           @map("org_id")
  role        Role
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invites     Invite[]         @relation("InviteCreator")
  access      ClientAccess[]
  auditEvents AuditEvent[]

  @@unique([userId, orgId])
  @@index([orgId, role])
  @@map("membership")
}

/// How a person becomes a member. The role is fixed when the invitation is
/// created, so joining is something an admin authorised rather than something a
/// shared secret allowed. Single use: a reusable code would be the shared
/// secret this table exists to replace.
model Invite {
  id          String       @id @default(uuid())
  orgId       String       @map("org_id")
  code        String       @unique
  role        Role
  /// Optional. When set, only a registration using this address may redeem it.
  email       String?
  expiresAt   DateTime?    @map("expires_at")
  revokedAt   DateTime?    @map("revoked_at")
  usedAt      DateTime?    @map("used_at")
  usedById    String?      @map("used_by_id")
  createdById String?      @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// SetNull on both: an invitation is the record of how someone joined, so it
  /// outlives the account that redeemed it and the membership that issued it.
  usedBy      User?        @relation(fields: [usedById], references: [id], onDelete: SetNull)
  createdBy   Membership?  @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt(sort: Desc)])
  @@map("invite")
}

model Client {
  id           String         @id @default(uuid())
  name         String
  /// Contact-book details. All optional: a client is usable long before anyone
  /// has collected its paperwork.
  fullName     String?        @map("full_name")
  organization String?
  unp          String?
  phone        String?
  telegram     String?
  email        String?
  website      String?
  image        String?
  avatarPath   String?        @map("avatar_path")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  projects     Project[]
  /// The relation is `org`, not `organization`: the contact-book field above
  /// already holds that name for the customer's own company.
  orgId        String         @map("org_id")
  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  access       ClientAccess[]

  @@index([orgId, createdAt])
  @@map("client")
}

/// How much attention a project needs. Named by what it means rather than by
/// the colour it is drawn in — the palette belongs to the interface.
enum ProjectPriority {
  CRITICAL /// очень важно
  URGENT /// есть срочные задачи
  WAITING /// в работе, ждём результата
  IDLE /// нет задач
  NEW /// новый

  @@map("project_priority")
}

/// The unit of work: what the agency runs for a client. Niche, budget and the
/// logo describe the project, not the company behind it — one client can run
/// several projects that share nothing but the contact details.
model Project {
  id            String          @id @default(uuid())
  clientId      String          @map("client_id")
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  niche         String?
  monthlyBudget Decimal?        @map("monthly_budget") @db.Decimal(12, 2)
  priority      ProjectPriority @default(NEW)
  image         String?
  avatarPath    String?         @map("avatar_path")
  position      Int
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  campaigns     Campaign[]
  access        ClientAccess[]

  @@index([clientId, position])
  @@map("project")
}

/// The role decides which verbs a member may use; this table decides which rows
/// they may use them on. Admins ignore it entirely and reach their whole
/// organization.
///
///   projectId null -> every project of the client
///   projectId set  -> that project only
model ClientAccess {
  id           String     @id @default(uuid())
  membershipId String     @map("membership_id")
  clientId     String     @map("client_id")
  projectId    String?    @map("project_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Postgres treats NULLs as distinct here, so this does not stop two
  /// whole-client grants; the migration adds a partial unique index for that.
  @@unique([membershipId, clientId, projectId])
  @@index([clientId])
  @@map("client_access")
}

/// An immutable snapshot of a business mutation. Actor details and the
/// readable summary are stored at write time so history remains meaningful
/// after a member leaves or an entity is renamed or deleted.
model AuditEvent {
  id         String       @id @default(uuid())
  orgId      String       @map("org_id")
  actorId    String?      @map("actor_id")
  actorName  String       @map("actor_name")
  actorEmail String       @map("actor_email")
  actorRole  Role         @map("actor_role")
  action     AuditAction
  entityType String       @map("entity_type")
  entityId   String       @map("entity_id")
  clientId   String?      @map("client_id")
  projectId  String?      @map("project_id")
  campaignId String?      @map("campaign_id")
  summary    String
  changes    Json?
  requestId  String?      @map("request_id")
  ip         String?
  userAgent  String?      @map("user_agent")
  createdAt  DateTime     @default(now()) @map("created_at")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor      Membership?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("audit_event")
}

model Campaign {
  id         String             @id @default(uuid())
  projectId  String             @map("project_id")
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  position   Int
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  properties CampaignProperty[]
  records    CampaignRecord[]

  @@index([projectId, position])
  @@map("campaign")
}

enum PropertyType {
  NUMBER
  MONEY
  PERCENT
  TEXT

  @@map("property_type")
}

model CampaignProperty {
  id         String                  @id @default(uuid())
  campaignId String                  @map("campaign_id")
  campaign   Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  key        String?
  type       PropertyType
  formula    Json?
  position   Int
  values     CampaignPropertyValue[]

  @@index([campaignId, position])
  @@map("campaign_property")
}

model CampaignRecord {
  id         String                  @id @default(uuid())
  campaignId String                  @map("campaign_id")
  campaign   Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date       DateTime                @db.Date
  values     CampaignPropertyValue[]

  @@unique([campaignId, date])
  @@map("campaign_record")
}

/// One value typed in by the user, at the intersection of a record (day) and a property.
/// Exists only for properties without a formula — computed metrics are never stored here.
model CampaignPropertyValue {
  id          String           @id @default(uuid())
  recordId    String           @map("record_id")
  propertyId  String           @map("property_id")
  record      CampaignRecord   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  property    CampaignProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  numberValue Decimal?         @map("number_value") @db.Decimal(18, 4)
  textValue   String?          @map("text_value")

  @@unique([recordId, propertyId])
  @@map("campaign_property_value")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String         @map("password_hash")
  image         String?
  avatarPath    String?        @map("avatar_path")
  createdAt     DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]
  memberships   Membership[]
  invitesUsed   Invite[]

  @@map("app_user")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_token")
}
