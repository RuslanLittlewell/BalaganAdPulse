DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adpulse?schema=public"
PORT=3000
# Both placeholders below MUST be replaced before deploying: they are published
# in this repository, and a token signed with this secret is accepted for any
# user. Startup refuses them when NODE_ENV=production.
JWT_SECRET=dev-secret-change-me
INVITE_CODE=adpulse-invite
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=adpulse
S3_SECRET_KEY=adpulse-local-secret
S3_BUCKET=adpulse-avatars
