---
import Download from "@lucide/astro/icons/download";
import FileText from "@lucide/astro/icons/file-text";
import AppScreen from "../app/AppScreen.astro";

const reports = [
  { month: "Сентябрь 2026", project: "Летний запуск", active: true },
  { month: "Сентябрь 2026", project: "Онлайн-школа" },
  { month: "Сентябрь 2026", project: "Студия йоги" },
  { month: "Август 2026", project: "Летний запуск" },
  { month: "Август 2026", project: "Онлайн-школа" },
  { month: "Июль 2026", project: "Летний запуск" },
];
const totals = [
  { label: "Расход", value: "4 120 $", change: "+6%" },
  { label: "Лиды", value: "386", change: "+18%" },
  { label: "Цена лида", value: "10,7 $", change: "−10%" },
  { label: "Выполнение KPI", value: "108%", change: "+12 п." },
];
const weeks = [
  { label: "1–7", leads: 74 },
  { label: "8–14", leads: 88 },
  { label: "15–21", leads: 101 },
  { label: "22–30", leads: 123 },
];
const months = [52, 61, 58, 70, 66, 79];
const ads = [
  { title: "Stories · скидка 20%", leads: 64, cpl: "8,9 $", tone: "from-primary/50" },
  { title: "Reels · отзыв клиента", leads: 51, cpl: "9,6 $", tone: "from-sky-500/40" },
  { title: "Лента · каталог", leads: 38, cpl: "11,2 $", tone: "from-amber-500/40" },
];
---

<AppScreen active="reports" path="/reports/letnij-zapusk/2026-09" caption="Отчёты в BalaganBI: ежемесячный отчёт по проекту">
  <div class="flex h-full gap-5">
    <div class="flex w-60 shrink-0 flex-col gap-2">
      <p class="text-xl font-semibold">Отчёты</p>
      <ul class="flex flex-col gap-1 text-sm">
        {reports.map((report) => (
          <li class:list={["flex items-center gap-2.5 rounded-lg px-2.5 py-2", report.active ? "bg-primary/10" : ""]}>
            <FileText class:list={["size-4 shrink-0", report.active ? "text-primary" : "text-muted-foreground"]} aria-hidden="true" />
            <span class="min-w-0">
              <span class:list={["block truncate", report.active && "font-semibold"]}>{report.month}</span>
              <span class="mock-blur block truncate text-xs text-muted-foreground">{report.project}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex min-w-0 flex-1 flex-col gap-4 rounded-2xl border border-border bg-background/50 p-5">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-lg font-semibold">Отчёт за сентябрь</p>
          <p class="text-sm text-muted-foreground"><span class="mock-blur">Летний запуск · Кофейня «Зерно»</span></p>
        </div>
        <span class="mock-pop inline-flex items-center gap-1.5 rounded-lg bg-foreground px-3 py-1.5 text-xs font-semibold text-background" style="--d: 1.3s">
          <Download class="size-3.5" aria-hidden="true" />
          Скачать PDF
        </span>
      </div>

      <div class="grid grid-cols-4 gap-2">
        {totals.map((total, index) => (
          <div class="mock-rise rounded-lg border border-border bg-card/60 p-3" style={`--d: ${index * 0.08}s`}>
            <p class="text-xs text-muted-foreground">{total.label}</p>
            <p class="mt-1 text-2xl font-semibold tabular-nums">{total.value}</p>
            <p class="mt-0.5 text-xs font-medium" style="color: var(--kpi-met)">{total.change} к августу</p>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-3">
        <div class="rounded-lg border border-border p-3">
          <p class="text-sm font-semibold">Лиды по неделям</p>
          <div class="mt-3 flex h-32 items-end gap-3">
            {weeks.map((week, index) => (
              <div class="flex flex-1 flex-col items-center gap-1.5">
                <span class="text-xs font-semibold tabular-nums">{week.leads}</span>
                <span class="mock-grow-y w-full rounded-md bg-primary/80" style={`height: ${week.leads * 0.85}px; --d: ${0.3 + index * 0.1}s`}></span>
                <span class="text-[11px] text-muted-foreground">{week.label} сент.</span>
              </div>
            ))}
          </div>
        </div>
        <div class="rounded-lg border border-border p-3">
          <p class="text-sm font-semibold">Лиды и цена лида за полгода</p>
          <svg viewBox="0 0 100 40" aria-hidden="true" class="mt-3 h-32 w-full text-primary" preserveAspectRatio="none">
            <polyline class="mock-draw" points={months.map((value, index) => `${index * 20},${40 - value * 0.45}`).join(" ")} pathLength="1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="--d: 0.5s" />
          </svg>
        </div>
      </div>

      <div>
        <p class="text-sm font-semibold">Лучшие объявления месяца</p>
        <div class="mt-2 grid grid-cols-3 gap-3">
          {ads.map((ad, index) => (
            <div class="mock-rise flex gap-3 rounded-lg border border-border p-2.5" style={`--d: ${0.8 + index * 0.1}s`}>
              <span class:list={["aspect-[4/5] w-14 shrink-0 rounded-md bg-gradient-to-br to-muted", ad.tone]}></span>
              <span class="min-w-0 text-xs">
                <span class="block truncate font-medium">{ad.title}</span>
                <span class="mt-1 block text-muted-foreground">Лиды: {ad.leads}</span>
                <span class="block text-muted-foreground">CPL: {ad.cpl}</span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</AppScreen>
