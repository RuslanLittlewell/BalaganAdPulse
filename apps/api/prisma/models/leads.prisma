enum LeadStage {
  NEW
  QUALIFIED
  TARGET
  PROPOSAL

  @@map("lead_stage")
}

enum LeadFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
  LINK

  @@map("lead_field_type")
}

enum LeadOrigin {
  MANUAL
  META

  @@map("lead_origin")
}

model LeadColumn {
  id         String       @id @default(uuid())
  orgId      String       @map("org_id")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId  String       @map("project_id")
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String       @db.VarChar(50)
  afterStage LeadStage?   @map("after_stage")
  position   Int          @default(0)
  color      String       @default("gray") @db.VarChar(16)
  leads      Lead[]
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([projectId, afterStage, position])
  @@map("lead_column")
}

model LeadField {
  id        String        @id @default(uuid())
  orgId     String        @map("org_id")
  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId String        @map("project_id")
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String        @db.VarChar(50)
  type      LeadFieldType
  options   Json          @default("[]")
  position  Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([projectId, position])
  @@map("lead_field")
}

model Lead {
  id           String          @id @default(uuid())
  orgId        String          @map("org_id")
  org          Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String          @db.VarChar(200)
  personId     String?         @map("person_id")
  person       Person?         @relation(fields: [personId], references: [id], onDelete: SetNull)
  companyId    String?         @map("company_id")
  company      Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  source       String?         @db.VarChar(200)
  notes        String?         @db.VarChar(10000)
  amount       Decimal?        @db.Decimal(18, 4)
  service      String?         @db.VarChar(200)
  tags         String[]        @default([])
  customValues Json            @default("{}") @map("custom_values")
  assigneeId   String?         @map("assignee_id")
  assignee     Membership?     @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  projectId    String          @map("project_id")
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaignId   String?         @map("campaign_id")
  campaign     Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adId         String?         @map("ad_id")
  ad           Ad?             @relation(fields: [adId], references: [id], onDelete: SetNull)
  origin       LeadOrigin      @default(MANUAL)
  metaSource   LeadMetaSource?
  metaKey      MetaLead?
  files        LeadFile[]
  stage        LeadStage?      @default(NEW)
  columnId     String?         @map("column_id")
  column       LeadColumn?     @relation(fields: [columnId], references: [id], onDelete: NoAction)
  position     Int             @default(0)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([projectId, stage, position])
  @@index([campaignId])
  @@index([adId])
  @@index([columnId])
  @@index([assigneeId])
  @@index([personId])
  @@index([companyId])
  @@map("lead")
}

model LeadFile {
  id          String       @id @default(uuid())
  orgId       String       @map("org_id")
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId      String       @map("lead_id")
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name        String       @db.VarChar(255)
  contentType String       @map("content_type") @db.VarChar(255)
  bytes       Int
  storageKey  String       @unique @map("storage_key")
  uploaderId  String?      @map("uploader_id")
  uploader    Membership?  @relation("LeadFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([leadId, createdAt(sort: Desc)])
  @@map("lead_file")
}

model LeadMetaSource {
  leadId             String   @id @map("lead_id")
  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  accountId          String   @map("account_id")
  formId             String   @map("form_id")
  campaignExternalId String   @map("campaign_external_id")
  campaignName       String   @map("campaign_name")
  adSetExternalId    String   @map("ad_set_external_id")
  adSetName          String   @map("ad_set_name")
  adExternalId       String   @map("ad_external_id")
  adName             String   @map("ad_name")
  submittedAt        DateTime @map("submitted_at")
  answers            Json
  answersOmitted     Boolean  @default(false) @map("answers_omitted")

  @@map("lead_meta_source")
}

model MetaLead {
  orgId      String       @map("org_id")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  externalId String       @map("external_id")
  leadId     String?      @unique @map("lead_id")
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  importedAt DateTime     @default(now()) @map("imported_at")

  @@id([orgId, externalId])
  @@map("meta_lead")
}

model Company {
  id        String       @id @default(uuid())
  orgId     String       @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clientId  String       @map("client_id")
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String       @db.VarChar(200)
  website   String?      @db.VarChar(2048)
  phone     String?      @db.VarChar(50)
  notes     String?      @db.VarChar(10000)
  people    Person[]
  leads     Lead[]
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([clientId, name])
  @@map("crm_company")
}

model Person {
  id          String       @id @default(uuid())
  orgId       String       @map("org_id")
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clientId    String       @map("client_id")
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String       @db.VarChar(200)
  phone       String?      @db.VarChar(50)
  phoneDigits String?      @default(dbgenerated()) @map("phone_digits") @db.VarChar(50)
  email       String?      @db.VarChar(254)
  telegram    String?      @db.VarChar(100)
  messenger   String?      @db.VarChar(100)
  companyId   String?      @map("company_id")
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  notes       String?      @db.VarChar(10000)
  leads       Lead[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([clientId, name])
  @@index([clientId, phoneDigits])
  @@map("crm_person")
}
