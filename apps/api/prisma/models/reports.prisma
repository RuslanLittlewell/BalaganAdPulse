enum ReportStatus {
  DRAFT
  PUBLISHED

  @@map("report_status")
}

model MonthlyReport {
  id                String            @id @default(uuid())
  projectId         String            @map("project_id")
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  month             DateTime          @db.Date
  status            ReportStatus      @default(DRAFT)
  currency          String?           @db.VarChar(3)
  figures           Json
  computedAt        DateTime          @map("computed_at")
  leadsOverride     Int?              @map("leads_override")
  messengerContacts Int?              @map("messenger_contacts")
  conclusions       Json?
  plan              Json?
  publishedAt       DateTime?         @map("published_at")
  coverKey          String?           @map("cover_key")
  coverContentType  String?           @map("cover_content_type")
  createdById       String?           @map("created_by_id")
  createdBy         Membership?       @relation("MonthlyReportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  ads               MonthlyReportAd[]

  @@unique([projectId, month])
  @@map("monthly_report")
}

model MonthlyReportAd {
  reportId String        @map("report_id")
  report   MonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  adId     String        @map("ad_id")
  ad       Ad            @relation(fields: [adId], references: [id], onDelete: Cascade)
  position Int

  @@id([reportId, adId])
  @@index([reportId, position])
  @@index([adId])
  @@map("monthly_report_ad")
}
