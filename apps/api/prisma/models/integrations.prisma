model ProjectIntegration {
  id                 String    @id @default(uuid())
  projectId          String    @map("project_id")
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider           String    @default("META")
  accountId          String    @map("account_id")
  leadsEnabled       Boolean   @default(false) @map("leads_enabled")
  encryptedToken     String    @map("encrypted_token")
  currency           String
  timezone           String
  revision           String
  status             String    @default("QUEUED")
  lastSuccessAt      DateTime? @map("last_success_at")
  lastError          String?   @map("last_error")
  nextDailyAt        DateTime  @map("next_daily_at")
  queuedAt           DateTime? @map("queued_at")
  retryCount         Int       @default(0) @map("retry_count")
  leaseOwner         String?   @map("lease_owner")
  leaseUntil         DateTime? @map("lease_until")
  leadsStatus        String    @default("WAITING") @map("leads_status")
  leadsCoveredUntil  DateTime? @map("leads_covered_until")
  leadsLastSuccessAt DateTime? @map("leads_last_success_at")
  leadsLastError     String?   @map("leads_last_error")
  nextLeadsAt        DateTime  @default(now()) @map("next_leads_at")
  leadsQueuedAt      DateTime? @map("leads_queued_at")
  nextSweepAt        DateTime? @map("next_sweep_at")
  leadsLeaseOwner    String?   @map("leads_lease_owner")
  leadsLeaseUntil    DateTime? @map("leads_lease_until")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@unique([projectId, accountId])
  @@index([nextDailyAt])
  @@index([queuedAt])
  @@index([nextLeadsAt])
  @@index([projectId])
  @@map("project_integration")
}
