---
interface Props {
  eyebrow: string;
  title: string;
  align?: "start" | "center";
}

const { eyebrow, title, align = "start" } = Astro.props;
const centered = align === "center";
---

<div data-reveal class:list={["flex max-w-3xl flex-col gap-4", centered && "mx-auto items-center text-center"]}>
  <p class="text-sm font-semibold tracking-wider text-primary uppercase">{eyebrow}</p>
  <h2 class="text-2xl leading-tight font-bold tracking-tight text-balance sm:text-3xl lg:text-4xl">{title}</h2>
  <slot />
</div>
