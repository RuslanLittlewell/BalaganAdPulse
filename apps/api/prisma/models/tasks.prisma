enum TaskColumn {
  IDEA
  ARCHIVED
  IN_PROGRESS
  NEEDS_FIX
  IN_REVIEW
  DONE

  @@map("task_column")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

enum TaskRepeat {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY

  @@map("task_repeat")
}

model Task {
  id              String       @id @default(uuid())
  projectId       String?      @map("project_id")
  orgId           String       @map("org_id")
  title           String
  description     Json?
  column          TaskColumn   @default(IDEA)
  priority        TaskPriority
  assigneeId      String?      @map("assignee_id")
  createdById     String?      @map("created_by_id")
  visibleToClient Boolean      @default(false) @map("visible_to_client")
  position        Int
  dueDate         DateTime?    @map("due_date") @db.Date
  dueTime         String?      @map("due_time") @db.VarChar(5)
  endTime         String?      @map("end_time") @db.VarChar(5)
  repeatEvery     TaskRepeat   @default(NONE) @map("repeat_every")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  project       Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee      Membership?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator       Membership?         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  images        TaskImage[]
  checklist     TaskChecklistItem[]
  participants  TaskParticipant[]
  notifications Notification[]

  @@index([orgId, column, position])
  @@index([projectId])
  @@index([orgId, visibleToClient])
  @@index([orgId, dueDate])
  @@map("task")
}

model TaskChecklistItem {
  id       String  @id @default(uuid())
  taskId   String  @map("task_id")
  title    String
  done     Boolean @default(false)
  position Int

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
  @@map("task_checklist_item")
}

model TaskParticipant {
  taskId       String @map("task_id")
  membershipId String @map("membership_id")

  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([taskId, membershipId])
  @@index([membershipId])
  @@map("task_participant")
}

model TaskImage {
  id          String   @id @default(uuid())
  taskId      String?  @map("task_id")
  uploaderId  String   @map("uploader_id")
  storageKey  String   @map("storage_key")
  contentType String   @map("content_type")
  bytes       Int
  createdAt   DateTime @default(now()) @map("created_at")

  task     Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader Membership @relation("TaskImageUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, createdAt])
  @@map("task_image")
}
