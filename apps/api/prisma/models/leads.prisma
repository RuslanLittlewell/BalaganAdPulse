enum LeadStage {
  NEW
  QUALIFIED
  TARGET
  PROPOSAL

  @@map("lead_stage")
}

enum LeadOrigin {
  MANUAL
  META

  @@map("lead_origin")
}

model LeadColumn {
  id         String       @id @default(uuid())
  orgId      String       @map("org_id")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId  String       @map("project_id")
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String       @db.VarChar(50)
  afterStage LeadStage?   @map("after_stage")
  position   Int          @default(0)
  leads      Lead[]
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([projectId, afterStage, position])
  @@map("lead_column")
}

model Lead {
  id         String          @id @default(uuid())
  orgId      String          @map("org_id")
  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String          @db.VarChar(200)
  company    String?         @db.VarChar(200)
  phone      String?         @db.VarChar(50)
  email      String?         @db.VarChar(254)
  website    String?         @db.VarChar(2048)
  source     String?         @db.VarChar(200)
  notes      String?         @db.VarChar(10000)
  amount     Decimal?        @db.Decimal(18, 4)
  service    String?         @db.VarChar(200)
  telegram   String?         @db.VarChar(100)
  messenger  String?         @db.VarChar(100)
  tags       String[]        @default([])
  assigneeId String?         @map("assignee_id")
  assignee   Membership?     @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  projectId  String          @map("project_id")
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaignId String?         @map("campaign_id")
  campaign   Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adId       String?         @map("ad_id")
  ad         Ad?             @relation(fields: [adId], references: [id], onDelete: SetNull)
  origin     LeadOrigin      @default(MANUAL)
  metaSource LeadMetaSource?
  metaKey    MetaLead?
  files      LeadFile[]
  stage      LeadStage?      @default(NEW)
  columnId   String?         @map("column_id")
  column     LeadColumn?     @relation(fields: [columnId], references: [id], onDelete: NoAction)
  position   Int             @default(0)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@index([projectId, stage, position])
  @@index([campaignId])
  @@index([adId])
  @@index([columnId])
  @@index([assigneeId])
  @@map("lead")
}

model LeadFile {
  id          String       @id @default(uuid())
  orgId       String       @map("org_id")
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId      String       @map("lead_id")
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name        String       @db.VarChar(255)
  contentType String       @map("content_type") @db.VarChar(255)
  bytes       Int
  storageKey  String       @unique @map("storage_key")
  uploaderId  String?      @map("uploader_id")
  uploader    Membership?  @relation("LeadFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([leadId, createdAt(sort: Desc)])
  @@map("lead_file")
}

model LeadMetaSource {
  leadId             String   @id @map("lead_id")
  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  accountId          String   @map("account_id")
  formId             String   @map("form_id")
  campaignExternalId String   @map("campaign_external_id")
  campaignName       String   @map("campaign_name")
  adSetExternalId    String   @map("ad_set_external_id")
  adSetName          String   @map("ad_set_name")
  adExternalId       String   @map("ad_external_id")
  adName             String   @map("ad_name")
  submittedAt        DateTime @map("submitted_at")
  answers            Json
  answersOmitted     Boolean  @default(false) @map("answers_omitted")

  @@map("lead_meta_source")
}

model MetaLead {
  orgId      String       @map("org_id")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  externalId String       @map("external_id")
  leadId     String?      @unique @map("lead_id")
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  importedAt DateTime     @default(now()) @map("imported_at")

  @@id([orgId, externalId])
  @@map("meta_lead")
}
