---
import CalendarDays from "@lucide/astro/icons/calendar-days";
import TriangleAlert from "@lucide/astro/icons/triangle-alert";
import { DEMO_PROJECTS } from "../../data/demoProjects";
import { RING, segments, type KpiCounts, type KpiPart } from "../../scripts/doughnut";

type Zone = "met" | "behind" | "danger" | "none";

const zoneOf = (kpi: number | null): Zone =>
  kpi === null ? "none" : kpi >= 90 ? "met" : kpi >= 70 ? "behind" : "danger";

const projects = DEMO_PROJECTS.map((project) => ({ ...project, zone: zoneOf(project.kpi) }));

const partOf = (zone: Zone): KpiPart => (zone === "none" ? "unrated" : zone);
const counts: KpiCounts = { met: 0, behind: 0, danger: 0, unrated: 0 };
for (const project of projects) counts[partOf(project.zone)] += 1;
const paths = segments(counts, projects.length);

const money = (value: number) => `${value.toLocaleString("ru-RU")} $`;
const decimal = (value: number, digits = 1) =>
  value.toLocaleString("ru-RU", { minimumFractionDigits: digits, maximumFractionDigits: digits });

const spend = projects.reduce((sum, project) => sum + project.spend, 0);
const leads = projects.reduce((sum, project) => sum + project.leads, 0);
const impressions = 1562400;
const clicks = 18950;
const reach = 679300;
const results = 436;

const tiles = [
  { metric: "spend", label: "Расход", value: spend, format: "money", hint: `CPM ${decimal((spend / impressions) * 1000)} $` },
  { metric: "impressions", label: "Показы", value: impressions, format: "count", hint: `Частота ${decimal(impressions / reach)}` },
  { metric: "clicks", label: "Клики", value: clicks, format: "count", hint: `CTR ${decimal((clicks / impressions) * 100, 2)}%` },
  { metric: "leads", label: "Лиды", value: leads, format: "count", hint: `CPL ${decimal(spend / leads)} $` },
  { metric: "results", label: "Результаты", value: results, format: "count", hint: `Цена результата ${decimal(spend / results)} $` },
  { metric: "cpc", label: "CPC", value: null, shown: `${decimal(spend / clicks, 2)} $`, format: "", hint: `Охват ${reach.toLocaleString("ru-RU")}` },
];

const periods = ["Неделя", "Месяц", "Квартал"];
const day = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("ru-RU", { day: "2-digit", month: "short", timeZone: "UTC" });
const month = `${day("2026-09-01")} – ${day("2026-09-30")}`;

const legend = [
  { key: "met", label: "Выполняют", color: "var(--kpi-neon-met)", glow: true },
  { key: "behind", label: "Небольшое отставание", color: "var(--kpi-neon-behind)", glow: true },
  { key: "danger", label: "Сильное отставание", color: "var(--kpi-neon-danger)", glow: true },
  { key: "unrated", label: "Без оценки", color: "var(--kpi-neon-none)", glow: false },
] as const;

const withoutKpi = projects.filter((project) => project.zone === "none");

const dueTasks = [
  { title: "Согласовать бюджет на октябрь", marker: "bg-red-500", when: "Просрочено 15 сент.", tone: "text-red-600 dark:text-red-400" },
  { title: "Созвон с клиентом", marker: "bg-amber-400", when: "Сегодня до 15:00", tone: "text-amber-600 dark:text-amber-400" },
  { title: "Обновить креативы для Reels", marker: "bg-sky-400", when: "Завтра", tone: "text-muted-foreground" },
  { title: "Отчёт за сентябрь", marker: "bg-border", when: "02 окт.", tone: "text-muted-foreground" },
];

const sources = [
  { name: "Meta", campaigns: 9, roas: "4,2×" },
  { name: "Google Ads", campaigns: 5, roas: "2,6×" },
].map((source) => {
  const amount = projects
    .filter((project) => project.channel === source.name)
    .reduce((sum, project) => sum + project.spend, 0);
  return { ...source, spend: amount, share: (amount / spend) * 100 };
});

const ROW_COLUMNS = "grid-cols-[minmax(0,1fr)_minmax(5rem,7rem)] @xl:grid-cols-[minmax(0,1fr)_5.5rem_minmax(5rem,8rem)] @4xl:grid-cols-[minmax(0,1fr)_6.5rem_4.5rem_5.5rem_minmax(6rem,11rem)]";
---

<div class="dashboard-body flex flex-col gap-4 @4xl:gap-5">
<div class="flex flex-wrap items-center justify-between gap-3">
  <p class="text-lg font-semibold @4xl:text-xl">Дашборд</p>
  <span class="flex items-center gap-2 text-[11px]">
    <span class="hidden items-center gap-0.5 rounded-lg bg-muted p-0.5 @xl:flex">
      {periods.map((period) => (
        <span class:list={["rounded-md px-2.5 py-1", period === "Месяц" ? "bg-card font-semibold shadow-sm" : "text-muted-foreground"]}>{period}</span>
      ))}
    </span>
    <span class="flex items-center gap-1.5 rounded-lg border border-border px-2.5 py-1 text-muted-foreground">
      <CalendarDays class="size-3" aria-hidden="true" />
      {month}
    </span>
  </span>
</div>

<ul class="grid grid-cols-2 gap-2 @2xl:grid-cols-3 @5xl:grid-cols-6" aria-label="Сводка">
  {tiles.map((tile) => (
    <li data-total={tile.metric} class="rounded-lg border border-border bg-card/60 p-3">
      <span class="block text-xs font-medium text-muted-foreground">{tile.label}</span>
      {tile.value === null ? (
        <span class="mt-1 block text-xl font-semibold tabular-nums @4xl:text-2xl">{tile.shown}</span>
      ) : (
        <span class="mt-1 block text-xl font-semibold tabular-nums @4xl:text-2xl" data-count={tile.value} data-format={tile.format}>
          {tile.format === "money" ? money(tile.value) : tile.value.toLocaleString("ru-RU")}
        </span>
      )}
      <span class="mt-0.5 block text-xs text-muted-foreground">{tile.hint}</span>
    </li>
  ))}
</ul>

<div class="grid gap-3 @2xl:grid-cols-2 @5xl:grid-cols-4">
  <section class="flex flex-col rounded-lg border border-border p-3" aria-label="Выполнение KPI за месяц">
    <div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-1">
      <h3 class="text-sm font-semibold">Выполнение KPI за месяц</h3>
      <span class="text-xs text-muted-foreground tabular-nums">{month}</span>
    </div>
    <div class="relative mx-auto mt-3 aspect-square w-full max-w-36">
      <svg viewBox="0 0 100 100" aria-hidden="true" class="size-full overflow-visible">
        <path d={RING} fill-rule="evenodd" stroke-width="1.5" stroke-linejoin="round" style="stroke: var(--kpi-neon-none); fill: color-mix(in srgb, var(--kpi-neon-none) 22%, transparent)" />
        {legend.map((part) => (
          <path
            data-segment={part.key}
            d={paths[part.key]}
            fill-rule="evenodd"
            stroke-width="1.5"
            stroke-linejoin="round"
            style={`stroke: ${part.color}; fill: color-mix(in srgb, ${part.color} 22%, transparent);${part.glow ? ` filter: drop-shadow(0 0 var(--kpi-neon-glow) ${part.color});` : ""}`}
          />
        ))}
      </svg>
      <p class="absolute inset-0 flex items-center justify-center text-base font-semibold tabular-nums">
        <span><span data-gauge-met>{counts.met}</span> из {projects.length}</span>
      </p>
    </div>
    <ul class="mt-3 flex flex-col gap-1 text-sm">
      {legend.map((part) => (
        <li class="flex items-center gap-2">
          <span aria-hidden="true" class="size-2 shrink-0 rounded-full" style={`background: ${part.color};${part.glow ? ` box-shadow: 0 0 6px ${part.color};` : ""}`}></span>
          <span class="flex-1 text-muted-foreground">{part.label}</span>
          <span data-legend={part.key} class="font-medium tabular-nums">{counts[part.key]}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="flex flex-col rounded-lg border border-border p-3" aria-label="Важная информация">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-semibold">Важная информация</h3>
      <span class="rounded-full bg-amber-500/15 px-2 py-0.5 text-xs font-medium tabular-nums text-amber-700 dark:text-amber-300">{withoutKpi.length}</span>
    </div>
    <ul class="-mx-2 mt-2 flex flex-col gap-0.5">
      {withoutKpi.map((project) => (
        <li class="flex items-center gap-2 rounded-md px-2 py-1 text-sm">
          <TriangleAlert class="size-3 shrink-0 text-amber-500" aria-hidden="true" />
          <span class="demo-blur min-w-0 flex-1 truncate font-medium">{project.name}</span>
          <span class="shrink-0 text-xs text-muted-foreground">KPI не задан</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="flex flex-col gap-2 rounded-lg border border-border p-3" aria-label="Задачи на сегодня и ближайшие дни">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-semibold">Задачи на сегодня и ближайшие дни</h3>
      <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium tabular-nums text-primary">{dueTasks.length}</span>
    </div>
    <ul class="-mx-2 flex flex-col gap-0.5">
      {dueTasks.map((task) => (
        <li class="flex items-center gap-2 rounded-md px-2 py-1 text-sm">
          <span aria-hidden="true" class:list={["h-5 w-1 shrink-0 rounded-full", task.marker]}></span>
          <span class="min-w-0 flex-1 truncate font-medium">{task.title}</span>
          <span class:list={["shrink-0 text-xs tabular-nums", task.tone]}>{task.when}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="rounded-lg border border-border p-3" aria-label="Источники">
    <h3 class="text-sm font-semibold">Источники</h3>
    <ul class="mt-3 flex flex-col gap-2">
      {sources.map((source) => (
        <li>
          <span class="flex items-baseline justify-between gap-2 text-sm">
            <span class="font-medium">{source.name}</span>
            <span class="text-muted-foreground tabular-nums">{money(source.spend)}</span>
          </span>
          <span class="mt-1 block h-1 overflow-hidden rounded-full bg-muted">
            <span class="demo-source block h-full rounded-full bg-primary" style={`width: ${source.share}%`}></span>
          </span>
          <span class="mt-1 block text-xs text-muted-foreground">Кампаний: {source.campaigns} · ROAS {source.roas}</span>
        </li>
      ))}
    </ul>
  </section>
</div>

<section class="min-w-0 rounded-lg border border-border" aria-label="Проекты">
  <div class:list={["grid items-center gap-3 border-b border-border px-4 py-2.5 text-xs font-semibold text-muted-foreground", ROW_COLUMNS]}>
    <span>Проект</span>
    <span class="hidden text-right @xl:block">Расход</span>
    <span class="hidden text-right @4xl:block">Лиды</span>
    <span class="hidden text-right @4xl:block">CPL</span>
    <span>Выполнение KPI</span>
  </div>
  <ul>
    {projects.map((project) => (
      <li
        data-row
        data-zone={project.zone}
        style={`--kpi-width: ${Math.min(project.kpi ?? 0, 100)}%`}
        class:list={["demo-row grid items-center gap-3 border-b border-border/60 px-3.5 py-2 text-sm last:border-b-0", ROW_COLUMNS]}
      >
        <span class="flex min-w-0 items-center gap-2.5">
          <span aria-hidden="true" class="demo-marker h-6 w-1 shrink-0 rounded-full"></span>
          <span class="min-w-0">
            <span class="demo-text demo-blur block truncate font-medium">{project.name}</span>
            <span class="demo-text demo-blur block text-xs text-muted-foreground">{project.channel}</span>
          </span>
        </span>
        <span class="hidden text-right tabular-nums @xl:block">
          <span class="demo-text demo-blur" data-count={project.spend} data-format="money">{money(project.spend)}</span>
        </span>
        <span class="hidden text-right tabular-nums @4xl:block">
          <span class="demo-text demo-blur" data-count={project.leads}>{project.leads}</span>
        </span>
        <span class="hidden text-right tabular-nums @4xl:block">
          <span class="demo-text demo-blur">{decimal(project.spend / project.leads)} $</span>
        </span>
        <span class="flex items-center gap-2">
          <span class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
            <span class="demo-fill block h-full rounded-full"></span>
          </span>
          {project.kpi === null ? (
            <span class="demo-text w-10 text-right text-xs text-muted-foreground">—</span>
          ) : (
            <span class="demo-text w-10 text-right text-xs font-semibold tabular-nums" data-count={project.kpi} data-format="percent">{project.kpi}%</span>
          )}
        </span>
      </li>
    ))}
  </ul>
</section>
</div>

<style>
  .demo-marker {
    background: var(--kpi-none);
    transition: background-color 0.4s ease;
  }
  .demo-row[data-zone="met"] .demo-marker,
  .demo-row[data-zone="met"] .demo-fill {
    background: var(--kpi-met);
  }
  .demo-row[data-zone="behind"] .demo-marker,
  .demo-row[data-zone="behind"] .demo-fill {
    background: var(--kpi-behind);
  }
  .demo-row[data-zone="danger"] .demo-marker,
  .demo-row[data-zone="danger"] .demo-fill {
    background: var(--kpi-danger);
  }
  .demo-fill {
    width: var(--kpi-width);
    transition: width 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .demo-text {
    transition: color 0.35s ease, background-color 0.35s ease;
    border-radius: 0.375rem;
  }
  .demo-row[data-pending] .demo-marker {
    background: var(--kpi-none);
  }
  .demo-row[data-pending] .demo-fill {
    width: 0;
  }
  .demo-blur {
    filter: blur(3.5px);
    user-select: none;
  }
  .demo-row[data-pending] .demo-text {
    color: transparent;
    background: var(--muted);
  }
  .demo-source {
    transform-origin: left center;
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global([data-demo][data-state="waiting"]) .demo-source {
    transform: scaleX(0);
  }
</style>
