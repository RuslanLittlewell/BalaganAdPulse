---
import CalendarDays from "@lucide/astro/icons/calendar-days";
import Phone from "@lucide/astro/icons/phone";
import Plus from "@lucide/astro/icons/plus";
import AppScreen from "../app/AppScreen.astro";

interface Lead {
  name: string;
  phone: string;
  source: string;
  amount?: string;
  day: string;
}

const columns: { title: string; color: string; sum: string; leads: Lead[] }[] = [
  { title: "Новый", color: "#4a8fe7", sum: "—", leads: [
    { name: "Анна Котова", phone: "+375 29 111-22-33", source: "Meta · лид-форма", day: "сегодня" },
    { name: "Игорь Павлов", phone: "+375 33 444-55-66", source: "Сайт", day: "сегодня" },
    { name: "Мария Лис", phone: "+375 29 777-88-99", source: "Meta · лид-форма", day: "вчера" },
  ] },
  { title: "Квалифицированный", color: "#b968d9", sum: "3 400 $", leads: [
    { name: "Ольга Смирнова", phone: "+375 44 123-45-67", source: "Google Ads", amount: "1 900 $", day: "16 сент." },
    { name: "Марк Дорофеев", phone: "+375 29 765-43-21", source: "Meta · лид-форма", amount: "1 500 $", day: "15 сент." },
  ] },
  { title: "Целевой", color: "#d9a441", sum: "2 800 $", leads: [
    { name: "Дина Романова", phone: "+375 33 222-11-00", source: "Рекомендация", amount: "2 800 $", day: "14 сент." },
  ] },
  { title: "КП", color: "#46b58a", sum: "4 100 $", leads: [
    { name: "Павел Нестеров", phone: "+375 29 999-00-11", source: "Google Ads", amount: "2 300 $", day: "12 сент." },
    { name: "Студия «Форма»", phone: "+375 44 555-66-77", source: "Сайт", amount: "1 800 $", day: "11 сент." },
  ] },
  { title: "Перезвонить", color: "#94a3b8", sum: "—", leads: [
    { name: "Виктор Ен", phone: "+375 33 888-77-66", source: "Meta · лид-форма", day: "10 сент." },
  ] },
];
---

<AppScreen active="crm" path="/crm/letnij-zapusk" caption="CRM в BalaganBI: лиды проекта по стадиям">
  <div class="flex h-full flex-col gap-4">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <p class="text-xl font-semibold">CRM</p>
        <span class="rounded-lg border border-border px-2.5 py-1 text-xs font-medium">Летний запуск</span>
        <span class="flex items-center gap-0.5 rounded-lg bg-muted p-0.5 text-xs">
          <span class="rounded-md bg-card px-3 py-1 font-semibold shadow-sm">Доска</span>
          <span class="px-3 py-1 text-muted-foreground">Таблица</span>
          <span class="px-3 py-1 text-muted-foreground">Календарь</span>
        </span>
      </div>
      <span class="flex items-center gap-1.5 rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground">
        <Plus class="size-3.5" aria-hidden="true" />
        Добавить лид
      </span>
    </div>

    <div class="grid min-h-0 flex-1 grid-cols-5 gap-3">
      {columns.map((column, columnIndex) => (
        <div class="flex min-w-0 flex-col gap-2">
          <div class="flex items-center justify-between gap-2 px-1">
            <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold" style={`background: color-mix(in srgb, ${column.color} 18%, transparent); color: ${column.color}`}>{column.title}</span>
            <span class="text-xs text-muted-foreground tabular-nums">{column.leads.length} · {column.sum}</span>
          </div>
          {columnIndex === 0 && (
            <div class="mock-pop rounded-xl border border-primary/60 bg-card p-3 shadow-lg ring-2 ring-primary/25" style="--d: 1s">
              <p class="mock-blur truncate text-sm font-medium">Елена Волкова</p>
              <p class="mock-blur mt-1 flex items-center gap-1 text-xs text-muted-foreground"><Phone class="size-3" aria-hidden="true" />+375 29 000-00-00</p>
              <p class="mt-2 flex items-center justify-between text-[11px]">
                <span class="rounded-md bg-primary/15 px-1.5 py-0.5 font-semibold text-primary">Meta · лид-форма</span>
                <span class="text-muted-foreground">только что</span>
              </p>
            </div>
          )}
          {column.leads.map((lead, index) => (
            <div class="mock-rise rounded-xl border border-border bg-card p-3" style={`--d: ${columnIndex * 0.08 + index * 0.06}s`}>
              <p class="flex items-start justify-between gap-2">
                <span class="mock-blur truncate text-sm font-medium">{lead.name}</span>
                {lead.amount && <span class="shrink-0 text-xs font-semibold tabular-nums">{lead.amount}</span>}
              </p>
              <p class="mock-blur mt-1 flex items-center gap-1 text-xs text-muted-foreground"><Phone class="size-3" aria-hidden="true" />{lead.phone}</p>
              <p class="mt-2 flex items-center justify-between text-[11px] text-muted-foreground">
                <span class="rounded-md bg-muted px-1.5 py-0.5">{lead.source}</span>
                <span class="flex items-center gap-1"><CalendarDays class="size-3" aria-hidden="true" />{lead.day}</span>
              </p>
            </div>
          ))}
          <span class="px-1 text-xs text-muted-foreground">+ Новый</span>
        </div>
      ))}
    </div>
  </div>
</AppScreen>
