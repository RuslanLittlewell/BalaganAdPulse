---
import ContactRound from "@lucide/astro/icons/contact-round";
import FileChartColumn from "@lucide/astro/icons/file-chart-column";
import FolderKanban from "@lucide/astro/icons/folder-kanban";
import LayoutDashboard from "@lucide/astro/icons/layout-dashboard";
import ListTodo from "@lucide/astro/icons/list-todo";
import UsersRound from "@lucide/astro/icons/users-round";
import CrmMock from "./mocks/CrmMock.astro";
import ProjectsMock from "./mocks/ProjectsMock.astro";
import ReportsMock from "./mocks/ReportsMock.astro";
import SummaryMock from "./mocks/SummaryMock.astro";
import TasksMock from "./mocks/TasksMock.astro";
import TeamMock from "./mocks/TeamMock.astro";

const modules = [
  {
    id: "dashboard",
    icon: LayoutDashboard,
    title: "Дашборд",
    mock: SummaryMock,
    lead: "Сводка по агентству за выбранный период: как идут все проекты и где нужна помощь.",
    points: [
      "Выполнение KPI за месяц по всем проектам",
      "Расходы, лиды и выручка по агентству и по каналам",
      "Кто из команды сейчас в сети",
      "Проекты, в которых не задан KPI",
    ],
  },
  {
    id: "projects",
    icon: FolderKanban,
    title: "Проекты",
    mock: ProjectsMock,
    lead: "Клиенты и их проекты: кампании, KPI и всё, что нужно для работы над проектом.",
    points: [
      "Таблица кампаний с цветовым индикатором KPI",
      "Вкладка на каждый подключённый кабинет",
      "KPI проекта по метрике кабинета или вручную",
      "Креативы объявлений, документы и контакты клиента",
    ],
  },
  {
    id: "tasks",
    icon: ListTodo,
    title: "Задачи",
    mock: TasksMock,
    lead: "Работа команды на доске и в календаре: от идеи до готового результата.",
    points: [
      "Канбан: идея, в работе, на исправление, на проверке, готово",
      "Календарь недели и отдельный вид для созвонов",
      "Участники, повторения, чек-листы и вложения",
      "Задачу можно надиктовать Telegram-боту",
    ],
  },
  {
    id: "crm",
    icon: ContactRound,
    title: "CRM",
    mock: CrmMock,
    lead: "Лиды клиентов по стадиям: от новой заявки до коммерческого предложения.",
    points: [
      "Доска стадий: новый, квалифицированный, целевой, КП",
      "Календарь лидов",
      "Лиды из лид-форм Meta приходят сами",
      "Файлы и ответы формы в карточке лида",
    ],
  },
  {
    id: "reports",
    icon: FileChartColumn,
    title: "Отчёты",
    mock: ReportsMock,
    lead: "Ежемесячный отчёт по проекту, который не стыдно отправить клиенту.",
    points: [
      "Итоги месяца по расходам и результатам",
      "Лучшие объявления месяца",
      "Выгрузка в PDF одной кнопкой",
    ],
  },
  {
    id: "team",
    icon: UsersRound,
    title: "Команда и доступ",
    mock: TeamMock,
    lead: "Кто что видит и что делает: роли, приглашения и журнал действий.",
    points: [
      "Роли администратора, менеджера, гостя и клиента",
      "Доступ к отдельным клиентам и проектам",
      "Приглашения по ссылке",
      "Журнал действий и кто сейчас в сети",
    ],
  },
];
---

<div data-module-tabs data-reveal class="flex flex-col gap-6 [overflow-anchor:none]">
  <div class="-mx-1 px-1 py-1 sm:overflow-x-auto">
    <div role="tablist" aria-label="Модули BalaganBI" hidden data-segment class="segment segment--mobile-vertical">
      {modules.map(({ id, icon: Icon, title }, index) => (
        <button
          type="button"
          role="tab"
          id={`module-tab-${id}`}
          aria-controls={`module-${id}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
        >
          <Icon class="size-4" aria-hidden="true" />
          {title}
        </button>
      ))}
    </div>
  </div>

  {modules.map(({ id, icon: Icon, title, lead, points, mock: Mock }) => (
    <section
      id={`module-${id}`}
      role="tabpanel"
      aria-labelledby={`module-tab-${id}`}
      class="tile grid items-center gap-8 p-3 sm:p-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-12"
    >
      <div class="flex flex-col gap-4">
        <span class="grid size-12 place-items-center rounded-2xl bg-primary/10 text-primary">
          <Icon class="size-6" aria-hidden="true" />
        </span>
        <h3 class="text-2xl font-bold tracking-tight sm:text-3xl">{title}</h3>
        <p class="leading-7 text-muted-foreground">{lead}</p>
        <ul class="flex flex-col gap-2 text-sm leading-6">
          {points.map((point) => (
            <li class="flex gap-2.5">
              <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"></span>
              {point}
            </li>
          ))}
        </ul>
      </div>
      <Mock />
    </section>
  ))}
</div>

<script>
  import { mountTabs, replay } from "../scripts/tabs";

  for (const root of document.querySelectorAll<HTMLElement>("[data-module-tabs]")) {
    let seen = false;
    mountTabs(root, (panel) => {
      if (seen) replay(panel);
    });
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        seen = true;
        const open = root.querySelector<HTMLElement>('[role="tabpanel"]:not([hidden])');
        if (open) replay(open);
      },
      { threshold: 0.3 },
    ).observe(root);
  }
</script>
