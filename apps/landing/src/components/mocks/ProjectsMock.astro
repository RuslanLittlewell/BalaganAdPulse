---
import MockWindow from "./MockWindow.astro";

const campaigns = [
  { name: "Лиды · Instagram", status: "Активна", zone: "met", kpi: 108 },
  { name: "Ретаргетинг · сайт", status: "Обучение", zone: "behind", kpi: 81 },
  { name: "Охват · Reels", status: "Активна", zone: "met", kpi: 95 },
  { name: "Лиды · лид-форма", status: "Пауза", zone: "none", kpi: 0 },
];
const colorOf = (zone: string) => `var(--kpi-${zone === "none" ? "none" : zone})`;
---

<MockWindow caption="Летний запуск · кампании" label="Проекты">
  <div class="flex flex-wrap gap-1.5 text-[11px] font-semibold">
    <span class="rounded-full bg-foreground px-3 py-1 text-background">Meta · <span class="mock-blur">act_1048</span></span>
    <span class="rounded-full border border-border px-3 py-1 text-muted-foreground">Google · <span class="mock-blur">222-333</span></span>
  </div>
  <div class="mock-rise mt-3 rounded-2xl border border-border p-3" style="--d: 0.1s">
    <div class="flex items-baseline justify-between gap-2">
      <p class="text-[11px] font-semibold">KPI проекта: лиды</p>
      <p class="text-xs font-semibold tabular-nums">86 из 80 · 108%</p>
    </div>
    <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-muted">
      <div class="mock-grow-x h-full w-full rounded-full" style="background: var(--kpi-met); --d: 0.3s"></div>
    </div>
  </div>
  <ul class="mt-3 overflow-hidden rounded-2xl border border-border">
    {campaigns.map((campaign, index) => (
      <li class="mock-rise grid grid-cols-[minmax(0,1fr)_auto_4.5rem] items-center gap-3 border-b border-border/60 px-3 py-2 text-xs last:border-b-0" style={`--d: ${0.25 + index * 0.12}s`}>
        <span class="flex min-w-0 items-center gap-2">
          <span class="h-5 w-1 shrink-0 rounded-full" style={`background: ${colorOf(campaign.zone)}`}></span>
          <span class="mock-blur truncate font-medium">{campaign.name}</span>
        </span>
        <span class="rounded-full bg-muted px-2 py-0.5 text-[10px] text-muted-foreground">{campaign.status}</span>
        <span class="text-right text-[11px] font-semibold tabular-nums">{campaign.zone === "none" ? "-" : `${campaign.kpi}%`}</span>
      </li>
    ))}
  </ul>
  <Fragment slot="footer">
    <span class="mock-chip">креативы</span>
    <span class="mock-chip">документы</span>
    <span class="mock-chip">контакты</span>
  </Fragment>
</MockWindow>
