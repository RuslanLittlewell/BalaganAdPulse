---
import Plus from "@lucide/astro/icons/plus";
import AppScreen from "../app/AppScreen.astro";

const members = [
  { name: "Анна Белова", email: "anna@balagan.pro", role: "Администратор", access: "Все клиенты", color: "#e8703a", seen: "в сети" },
  { name: "Игорь Петров", email: "igor@balagan.pro", role: "Менеджер", access: "4 клиента", color: "#4a8fe7", seen: "в сети" },
  { name: "Ольга Смирнова", email: "olga@balagan.pro", role: "Менеджер", access: "2 клиента", color: "#46b58a", seen: "был вчера" },
  { name: "Дмитрий Ким", email: "dmitry@balagan.pro", role: "Гость", access: "1 проект", color: "#d9a441", seen: "3 дня назад" },
  { name: "Марк Дорофеев", email: "mark@zerno.by", role: "Главный у клиента", access: "Кофейня «Зерно»", color: "#b968d9", seen: "в сети" },
  { name: "Лена Орлова", email: "lena@zerno.by", role: "Клиент", access: "Летний запуск", color: "#e05d8a", seen: "был сегодня" },
];
const log = [
  { time: "10:42", who: "Анна", what: "подключила кабинет Google Ads к «Летнему запуску»" },
  { time: "10:15", who: "Игорь", what: "изменил KPI проекта: 80 лидов в месяц" },
  { time: "09:58", who: "Марк", what: "открыл отчёт за август" },
  { time: "09:31", who: "Анна", what: "пригласила сотрудника клиента" },
  { time: "вчера", who: "Ольга", what: "перенесла задачу в «На проверке»" },
  { time: "вчера", who: "Игорь", what: "добавил проект «Кофейня»" },
];
const roleTone: Record<string, string> = {
  Администратор: "bg-primary/15 text-primary",
  Менеджер: "bg-sky-500/15 text-sky-700 dark:text-sky-300",
  Гость: "bg-muted text-muted-foreground",
  "Главный у клиента": "bg-violet-500/15 text-violet-700 dark:text-violet-300",
  Клиент: "bg-violet-500/10 text-violet-700 dark:text-violet-300",
};
const COLUMNS = "grid-cols-[minmax(0,1.4fr)_9.5rem_minmax(0,1fr)_6rem]";
---

<AppScreen active="team" path="/team" caption="Команда в BalaganBI: роли, доступ и журнал действий">
  <div class="flex h-full flex-col gap-4">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <p class="text-xl font-semibold">Команда</p>
        <span class="flex items-center gap-0.5 rounded-lg bg-muted p-0.5 text-xs">
          <span class="rounded-md bg-card px-3 py-1 font-semibold shadow-sm">Участники</span>
          <span class="px-3 py-1 text-muted-foreground">Приглашения</span>
          <span class="px-3 py-1 text-muted-foreground">Журнал</span>
        </span>
      </div>
      <span class="flex items-center gap-1.5 rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground">
        <Plus class="size-3.5" aria-hidden="true" />
        Пригласить
      </span>
    </div>

    <div class="grid min-h-0 flex-1 grid-cols-[minmax(0,2fr)_minmax(0,1fr)] gap-4">
      <div class="overflow-hidden rounded-lg border border-border">
        <div class:list={["grid items-center gap-3 border-b border-border bg-muted/30 px-4 py-2.5 text-xs font-semibold text-muted-foreground", COLUMNS]}>
          <span>Участник</span>
          <span>Роль</span>
          <span>Доступ</span>
          <span>Активность</span>
        </div>
        {members.map((member, index) => (
          <div class:list={["mock-rise grid items-center gap-3 border-b border-border/60 px-4 py-3 text-sm", COLUMNS]} style={`--d: ${index * 0.08}s`}>
            <span class="flex min-w-0 items-center gap-3">
              <span class="relative grid size-8 shrink-0 place-items-center rounded-full text-xs font-bold text-white" style={`background: ${member.color}`}>
                <span class="mock-blur">{member.name.slice(0, 1)}</span>
                {member.seen === "в сети" && <span class="absolute -right-0.5 -bottom-0.5 size-3 rounded-full border-2 border-card" style="background: var(--kpi-met)"></span>}
              </span>
              <span class="min-w-0">
                <span class="mock-blur block truncate font-medium">{member.name}</span>
                <span class="mock-blur block truncate text-xs text-muted-foreground">{member.email}</span>
              </span>
            </span>
            <span><span class:list={["rounded-full px-2 py-0.5 text-xs", roleTone[member.role]]}>{member.role}</span></span>
            <span class="truncate text-xs text-muted-foreground">{member.access}</span>
            <span class="text-xs text-muted-foreground">{member.seen}</span>
          </div>
        ))}
      </div>

      <div class="flex flex-col gap-3">
        <div class="rounded-lg border border-border p-3">
          <p class="text-sm font-semibold">Сейчас в сети</p>
          <div class="mt-2 flex items-center">
            {members.filter((member) => member.seen === "в сети").map((member, index) => (
              <span class="mock-pop -ml-2 grid size-9 place-items-center rounded-full border-2 border-card text-xs font-bold text-white first:ml-0" style={`background: ${member.color}; --d: ${0.4 + index * 0.1}s`}>
                <span class="mock-blur">{member.name.slice(0, 1)}</span>
              </span>
            ))}
            <span class="ml-3 text-xs text-muted-foreground">3 из 6</span>
          </div>
        </div>
        <div class="min-h-0 flex-1 rounded-lg border border-border p-3">
          <p class="text-sm font-semibold">Журнал действий</p>
          <ul class="mt-2 flex flex-col gap-2.5">
            {log.map((entry, index) => (
              <li class="mock-rise flex gap-2.5 text-xs leading-5" style={`--d: ${0.6 + index * 0.15}s`}>
                <span class="w-10 shrink-0 text-muted-foreground tabular-nums">{entry.time}</span>
                <span><span class="mock-blur font-semibold">{entry.who}</span> <span class="text-muted-foreground">{entry.what}</span></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</AppScreen>
