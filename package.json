{
  "name": "adpulse",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:policy": "npm run build -w @adpulse/access-policy",
    "predev": "npm run build:policy",
    "dev": "npm run dev -w apps/api",
    "pretest": "npm run build:policy",
    "test": "npm test -w @adpulse/access-policy && npm test -w apps/api",
    "prebuild": "npm run build:policy",
    "build": "npm run build -w apps/api",
    "predev:web": "npm run build:policy",
    "dev:web": "npm run dev -w @adpulse/web",
    "prebuild:web": "npm run build:policy",
    "build:web": "npm run build -w @adpulse/web",
    "pretest:web": "npm run build:policy",
    "test:web": "npm run test -w @adpulse/web",
    "db:up": "docker compose up -d db",
    "predev:all": "npm run db:up && npm run build:policy",
    "dev:all": "concurrently -k -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev:web\"",
    "stack": "docker compose up",
    "stack:bg": "docker compose up -d",
    "stack:down": "docker compose down",
    "postinstall": "node scripts/patch-avataaars-react.cjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "concurrently": "^9.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
