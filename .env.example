POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=adpulse
# Passed to the api container. The placeholder below MUST be replaced before
# deploying: it is published in this repository, and a token signed with this
# secret is accepted for any user. Startup refuses it when NODE_ENV=production.
JWT_SECRET=dev-secret-change-me
# Read only by `npm run seed`, which creates the organization's first admin.
# Registration needs an invitation and an invitation needs an admin, so a fresh
# database has to be seeded once before anyone can sign up.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
# Optional organization display name applied by the first-admin seed.
ORG_NAME=AdPulse
S3_REGION=us-east-1
S3_ACCESS_KEY=adpulse
S3_SECRET_KEY=adpulse-local-secret
S3_BUCKET=adpulse-avatars
# Set to `off` to stop serving /api/docs and /api/openapi.json.
API_DOCS=on

INTEGRATION_ENCRYPTION_KEY=
META_GRAPH_VERSION=v22.0
