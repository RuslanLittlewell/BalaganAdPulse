generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  GUEST
  CLIENT
  CLIENT_ADMIN

  @@map("role")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED

  @@map("membership_status")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE

  @@map("audit_action")
}

enum RegistrationType {
  CLIENT
  EMPLOYEE
  CLIENT_STAFF

  @@map("registration_type")
}

model Organization {
  leads       Lead[]
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  members     Membership[]
  clients     Client[]
  invites     Invite[]
  auditEvents AuditEvent[]
  tasks       Task[]

  @@map("organization")
}

model Membership {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  orgId       String           @map("org_id")
  role        Role
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invites     Invite[]         @relation("InviteCreator")
  access      ClientAccess[]
  auditEvents AuditEvent[]

  assignedTasks  Task[]      @relation("TaskAssignee")
  createdTasks   Task[]      @relation("TaskCreator")
  uploadedImages TaskImage[] @relation("TaskImageUploader")

  @@unique([userId, orgId])
  @@index([orgId, role])
  @@map("membership")
}

model Invite {
  id               String           @id @default(uuid())
  orgId            String           @map("org_id")
  code             String           @unique
  registrationType RegistrationType @default(EMPLOYEE) @map("registration_type")
  role             Role?
  clientId         String?          @map("client_id")
  email            String?
  expiresAt        DateTime?        @map("expires_at")
  revokedAt        DateTime?        @map("revoked_at")
  usedAt           DateTime?        @map("used_at")
  usedById         String?          @map("used_by_id")
  createdById      String?          @map("created_by_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  org              Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  usedBy           User?            @relation(fields: [usedById], references: [id], onDelete: SetNull)
  createdBy        Membership?      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  client           Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projects         InviteProject[]

  @@index([orgId, createdAt(sort: Desc)])
  @@index([clientId])
  @@map("invite")
}

enum TaskColumn {
  IDEA
  ARCHIVED
  IN_PROGRESS
  NEEDS_FIX
  IN_REVIEW
  DONE

  @@map("task_column")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

model Task {
  id              String       @id @default(uuid())
  projectId       String       @map("project_id")
  orgId           String       @map("org_id")
  title           String
  description     Json?
  column          TaskColumn   @default(IDEA)
  priority        TaskPriority
  assigneeId      String?      @map("assignee_id")
  createdById     String?      @map("created_by_id")
  campaignId      String?      @map("campaign_id")
  visibleToClient Boolean      @default(false) @map("visible_to_client")
  position        Int
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee Membership?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  campaign Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  creator  Membership?  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  images   TaskImage[]

  @@index([orgId, column, position])
  @@index([projectId])
  @@index([campaignId])
  @@index([orgId, visibleToClient])
  @@map("task")
}

model TaskImage {
  id          String   @id @default(uuid())
  taskId      String?  @map("task_id")
  uploaderId  String   @map("uploader_id")
  storageKey  String   @map("storage_key")
  contentType String   @map("content_type")
  bytes       Int
  createdAt   DateTime @default(now()) @map("created_at")

  task     Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader Membership @relation("TaskImageUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, createdAt])
  @@map("task_image")
}

model Client {
  leads        Lead[]
  id           String         @id @default(uuid())
  name         String
  fullName     String?        @map("full_name")
  organization String?
  unp          String?
  phone        String?
  telegram     String?
  email        String?
  website      String?
  image        String?
  avatarPath   String?        @map("avatar_path")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  projects     Project[]
  invitations  Invite[]
  orgId        String         @map("org_id")
  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  access       ClientAccess[]

  @@index([orgId, createdAt])
  @@unique([id, orgId])
  @@map("client")
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  DEFERRED
  @@map("lead_stage")
}

model Lead {
  id        String @id @default(uuid())
  orgId     String @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clientId  String? @map("client_id")
  client    Client? @relation(fields: [clientId, orgId], references: [id, orgId], onDelete: Cascade)
  name      String @db.VarChar(200)
  company   String? @db.VarChar(200)
  phone     String? @db.VarChar(50)
  email     String? @db.VarChar(254)
  website   String? @db.VarChar(2048)
  source    String? @db.VarChar(200)
  notes     String? @db.VarChar(10000)
  projectId  String? @map("project_id")
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  campaignId String? @map("campaign_id")
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  stage     LeadStage @default(NEW)
  position  Int @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([orgId, clientId, stage, position])
  @@index([projectId])
  @@index([campaignId])
  @@map("lead")
}

enum ProjectPriority {
  CRITICAL
  URGENT
  WAITING
  IDLE
  NEW

  @@map("project_priority")
}

enum Currency {
  BYN
  RUB
  USD
  EUR

  @@map("currency")
}

model Project {
  id             String          @id @default(uuid())
  clientId       String          @map("client_id")
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name           String
  niche          String?
  monthlyBudget  Decimal?        @map("monthly_budget") @db.Decimal(12, 2)
  budgetCurrency Currency        @default(BYN) @map("budget_currency")
  priority       ProjectPriority @default(NEW)
  image          String?
  avatarPath     String?         @map("avatar_path")
  position       Int
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  campaigns      Campaign[]
  leads          Lead[]
  access         ClientAccess[]
  tasks          Task[]
  invitations    InviteProject[]

  @@index([clientId, position])
  @@map("project")
}

model InviteProject {
  inviteId  String   @map("invite_id")
  projectId String   @map("project_id")
  invite    Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([inviteId, projectId])
  @@index([projectId])
  @@map("invite_project")
}

model ClientAccess {
  id           String     @id @default(uuid())
  membershipId String     @map("membership_id")
  clientId     String     @map("client_id")
  projectId    String?    @map("project_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([membershipId, clientId, projectId])
  @@index([clientId])
  @@map("client_access")
}

model AuditEvent {
  id         String       @id @default(uuid())
  orgId      String       @map("org_id")
  actorId    String?      @map("actor_id")
  actorName  String       @map("actor_name")
  actorEmail String       @map("actor_email")
  actorRole  Role         @map("actor_role")
  action     AuditAction
  entityType String       @map("entity_type")
  entityId   String       @map("entity_id")
  clientId   String?      @map("client_id")
  projectId  String?      @map("project_id")
  campaignId String?      @map("campaign_id")
  summary    String
  changes    Json?
  requestId  String?      @map("request_id")
  ip         String?
  userAgent  String?      @map("user_agent")
  createdAt  DateTime     @default(now()) @map("created_at")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor      Membership?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("audit_event")
}

enum Channel {
  META
  GOOGLE
  YANDEX
  VK
  TIKTOK
  LINKEDIN
  TELEGRAM

  @@map("channel")
}

enum DeliveryStatus {
  ACTIVE
  LEARNING
  PAUSED
  REJECTED
  ENDED

  @@map("delivery_status")
}

model Campaign {
  id         String                @id @default(uuid())
  projectId  String                @map("project_id")
  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  channel    Channel
  status     DeliveryStatus        @default(ACTIVE)
  objective  String?
  externalId String?               @map("external_id")
  position   Int
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  adSets     AdSet[]
  metrics    CampaignDailyMetric[]
  tasks      Task[]
  leads      Lead[]

  @@unique([channel, externalId])
  @@index([projectId, position])
  @@map("campaign")
}

model AdSet {
  id         String             @id @default(uuid())
  campaignId String             @map("campaign_id")
  campaign   Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  audience   String?
  status     DeliveryStatus     @default(ACTIVE)
  externalId String?            @map("external_id")
  position   Int
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  ads        Ad[]
  metrics    AdSetDailyMetric[]

  @@index([campaignId, position])
  @@map("ad_set")
}

model Ad {
  id         String          @id @default(uuid())
  adSetId    String          @map("ad_set_id")
  adSet      AdSet           @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  name       String
  format     String?
  headline   String?
  status     DeliveryStatus  @default(ACTIVE)
  externalId String?         @map("external_id")
  position   Int
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  metrics    AdDailyMetric[]

  @@index([adSetId, position])
  @@map("ad")
}

model CampaignDailyMetric {
  campaignId  String   @map("campaign_id")
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  spend       Decimal  @default(0) @db.Decimal(18, 4)
  impressions Int      @default(0)
  reach       Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  revenue     Decimal  @default(0) @db.Decimal(18, 4)
  syncedAt    DateTime @default(now()) @map("synced_at")

  @@id([campaignId, date])
  @@index([date])
  @@map("campaign_daily_metric")
}

model AdSetDailyMetric {
  adSetId     String   @map("ad_set_id")
  adSet       AdSet    @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  spend       Decimal  @default(0) @db.Decimal(18, 4)
  impressions Int      @default(0)
  reach       Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  revenue     Decimal  @default(0) @db.Decimal(18, 4)
  syncedAt    DateTime @default(now()) @map("synced_at")

  @@id([adSetId, date])
  @@index([date])
  @@map("ad_set_daily_metric")
}

model AdDailyMetric {
  adId        String   @map("ad_id")
  ad          Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  spend       Decimal  @default(0) @db.Decimal(18, 4)
  impressions Int      @default(0)
  reach       Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  revenue     Decimal  @default(0) @db.Decimal(18, 4)
  syncedAt    DateTime @default(now()) @map("synced_at")

  @@id([adId, date])
  @@index([date])
  @@map("ad_daily_metric")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String         @map("password_hash")
  image         String?
  avatarPath    String?        @map("avatar_path")
  phone         String?
  telegram      String?
  createdAt     DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]
  memberships   Membership[]
  invitesUsed   Invite[]

  @@map("app_user")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_token")
}
