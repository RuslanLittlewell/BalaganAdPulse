enum SummaryTile {
  SPEND
  IMPRESSIONS
  CLICKS
  CONVERSIONS
  RESULTS
  CPC
  KPI

  @@map("summary_tile")
}

model Project {
  id                   String                  @id @default(uuid())
  clientId             String                  @map("client_id")
  client               Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                 String
  budgetCurrency       String?                 @map("budget_currency") @db.VarChar(3)
  image                String?
  avatarPath           String?                 @map("avatar_path")
  position             Int
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  campaigns            Campaign[]
  leads                Lead[]
  leadColumns          LeadColumn[]
  leadFields           LeadField[]
  access               ClientAccess[]
  tasks                Task[]
  invitations          InviteProject[]
  integrations         ProjectIntegration[]
  googleAuthorizations GoogleAuthorization[]
  placements           ProjectPlacement[]
  reports              MonthlyReport[]
  monthFigures         ProjectMonthFigure[]
  documents            ProjectDocument[]
  notifications        Notification[]
  kpis                 ProjectKpi[]
  kpiMetMonth          DateTime?               @map("kpi_met_month") @db.Date
  kpiTracked           Boolean                 @default(true) @map("kpi_tracked")
  summaryTiles         SummaryTile[]           @default([]) @map("summary_tiles")
  accountSummaries     ProjectAccountSummary[]
  seoSites             SeoSite[]
  shareLink            ProjectShareLink?
  stageChanges         LeadStageChange[]
  conversionEvents     CrmConversionEvent[]
  metaDataset          MetaDataset?
  conversionSends      MetaConversionSend[]

  @@index([clientId, position])
  @@map("project")
}

model ProjectAccountSummary {
  id        String        @id @default(uuid())
  projectId String        @map("project_id")
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel   Channel
  accountId String        @map("account_id")
  tiles     SummaryTile[] @default([])
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@unique([projectId, channel, accountId])
  @@map("project_account_summary")
}

model ProjectShareLink {
  id          String      @id @default(uuid())
  projectId   String      @unique @map("project_id")
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  token       String      @unique @db.VarChar(64)
  createdById String?     @map("created_by_id")
  createdBy   Membership? @relation("ProjectShareLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("project_share_link")
}
