generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id            String   @id @default(uuid())
  name          String
  niche         String?
  monthlyBudget Decimal? @db.Decimal(12, 2)
  email         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
