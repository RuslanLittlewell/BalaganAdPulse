model SeoSite {
  id              String         @id @default(uuid())
  projectId       String         @map("project_id")
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteUrl         String         @map("site_url")
  origin          String?
  encryptedToken  String         @map("encrypted_token")
  revision        String
  status          String         @default("QUEUED") @db.VarChar(16)
  lastSuccessAt   DateTime?      @map("last_success_at")
  lastError       String?        @map("last_error")
  nextDailyAt     DateTime       @map("next_daily_at")
  queuedAt        DateTime?      @map("queued_at")
  retryCount      Int            @default(0) @map("retry_count")
  leaseOwner      String?        @map("lease_owner")
  leaseUntil      DateTime?      @map("lease_until")
  vitalsReadAt    DateTime?      @map("vitals_read_at")
  checkStatus     String         @default("QUEUED") @map("check_status") @db.VarChar(16)
  lastCheckAt     DateTime?      @map("last_check_at")
  checkError      String?        @map("check_error")
  nextCheckAt     DateTime       @map("next_check_at")
  checkQueuedAt   DateTime?      @map("check_queued_at")
  checkLeaseOwner String?        @map("check_lease_owner")
  checkLeaseUntil DateTime?      @map("check_lease_until")
  createdAt       DateTime       @default(now()) @map("created_at")
  days            SeoDay[]
  queries         SeoQueryDay[]
  pages           SeoPageDay[]
  vitals          SeoVital[]
  vitalWeeks      SeoVitalWeek[]
  labs            SeoLab[]
  audit           SeoAudit?

  @@unique([projectId, siteUrl])
  @@index([nextDailyAt])
  @@index([nextCheckAt])
  @@map("seo_site")
}

model SeoDay {
  siteId      String   @map("site_id")
  site        SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  clicks      Int
  impressions Int
  position    Decimal  @db.Decimal(10, 4)

  @@id([siteId, date])
  @@map("seo_day")
}

model SeoQueryDay {
  siteId      String   @map("site_id")
  site        SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  query       String
  clicks      Int
  impressions Int
  position    Decimal  @db.Decimal(10, 4)

  @@id([siteId, date, query])
  @@map("seo_query_day")
}

model SeoPageDay {
  siteId      String   @map("site_id")
  site        SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  page        String
  clicks      Int
  impressions Int
  position    Decimal  @db.Decimal(10, 4)

  @@id([siteId, date, page])
  @@map("seo_page_day")
}

model SeoVital {
  siteId           String   @map("site_id")
  site             SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  device           String   @db.VarChar(8)
  metric           String   @db.VarChar(8)
  periodEnd        DateTime @map("period_end") @db.Date
  p75              Decimal  @db.Decimal(12, 4)
  good             Decimal  @db.Decimal(6, 4)
  needsImprovement Decimal  @map("needs_improvement") @db.Decimal(6, 4)
  poor             Decimal  @db.Decimal(6, 4)

  @@id([siteId, device, metric])
  @@map("seo_vital")
}

model SeoVitalWeek {
  siteId    String   @map("site_id")
  site      SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  device    String   @db.VarChar(8)
  metric    String   @db.VarChar(8)
  periodEnd DateTime @map("period_end") @db.Date
  p75       Decimal  @db.Decimal(12, 4)

  @@id([siteId, device, metric, periodEnd])
  @@map("seo_vital_week")
}

model SeoLab {
  siteId       String   @map("site_id")
  site         SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  device       String   @db.VarChar(8)
  measuredAt   DateTime @map("measured_at")
  score        Int
  lcpMs        Int      @map("lcp_ms")
  cls          Decimal  @db.Decimal(8, 4)
  tbtMs        Int      @map("tbt_ms")
  fcpMs        Int      @map("fcp_ms")
  speedIndexMs Int      @map("speed_index_ms")

  @@id([siteId, device])
  @@map("seo_lab")
}

model SeoAudit {
  id         String         @id @default(uuid())
  siteId     String         @unique @map("site_id")
  site       SeoSite        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  finishedAt DateTime       @map("finished_at")
  checked    Int
  notChecked Int            @map("not_checked")
  pages      SeoAuditPage[]

  @@map("seo_audit")
}

model SeoAuditPage {
  id             String   @id @default(uuid())
  auditId        String   @map("audit_id")
  audit          SeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  url            String
  status         Int?
  finalUrl       String?  @map("final_url")
  contentType    String?  @map("content_type")
  responseMs     Int?     @map("response_ms")
  inSitemap      Boolean  @map("in_sitemap")
  hasImpressions Boolean  @map("has_impressions")
  facts          Json
  problems       String[]

  @@unique([auditId, url])
  @@map("seo_audit_page")
}
