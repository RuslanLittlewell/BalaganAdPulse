model ProjectDocument {
  id          String      @id @default(uuid())
  projectId   String      @map("project_id")
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  content     Json?
  createdById String?     @map("created_by_id")
  createdBy   Membership? @relation("ProjectDocumentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?     @map("updated_by_id")
  updatedBy   Membership? @relation("ProjectDocumentEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  notifications Notification[]

  @@index([projectId, createdAt])
  @@map("project_document")
}
